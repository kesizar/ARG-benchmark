{
  "hooks": {
    "mailbox_login": {
      "type": "localstorage",
      "key": "benchmark_gongwei_mailbox_login",
      "mode": "exists"
    },
    "weibo_login": {
      "type": "localstorage",
      "key": "benchmark_gongwei_weibo_login",
      "mode": "exists"
    },
    "recording_unlock": {
      "type": "localstorage",
      "key": "benchmark_gongwei_recording_unlock",
      "mode": "exists"
    },
    "oa_login": {
      "type": "localstorage",
      "key": "benchmark_gongwei_oa_login",
      "mode": "exists"
    },
    "financial_unlock": {
      "type": "localstorage",
      "key": "benchmark_gongwei_financial_unlock",
      "mode": "exists"
    },
    "complete": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/finalX.html') && !!document.querySelector('.container h1') && document.querySelector('.container h1').textContent.trim() === 'BUG REPORT' && localStorage.getItem('benchmark_gongwei_financial_unlock') === '1'"
    },
    "desk": {
      "type": "url_regex",
      "pattern": "/desk\\.html$"
    },
    "search_miss": {
      "type": "dom_regex",
      "pattern": "未找到匹配结果"
    }
  },
  "checkpoints": [
    {
      "id": "mailbox_login",
      "hook": "mailbox_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "weibo_login",
      "hook": "weibo_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "recording_unlock",
      "hook": "recording_unlock",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "oa_login",
      "hook": "oa_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "financial_unlock",
      "hook": "financial_unlock",
      "op": "truthy",
      "role": "critical"
    }
  ],
  "events": {
    "desk_opened": {
      "hook": "desk",
      "op": "truthy"
    },
    "search_miss": {
      "hook": "search_miss",
      "op": "truthy"
    }
  },
  "routes": [
    {
      "id": "completed",
      "tier": "normal",
      "gates": [
        "financial_unlock"
      ],
      "ending": {
        "hook": "complete",
        "op": "truthy"
      }
    }
  ],
  "ending": null,
  "answer_sha256": [],
  "answer_hash_file": null,
  "request_milestones": [],
  "submit_conclusion": {
    "enabled": false,
    "schema": null
  },
  "rubric_path": null
}
