{
  "hooks": {
    "ending": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#screen-end.active .end-title\") && !document.querySelector(\"#gameover-overlay\")"
    },
    "failure": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#gameover-overlay .go-reason\")"
    },
