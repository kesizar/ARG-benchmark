{
  "hooks": {
    "reverse": {
      "type": "js_truthy",
      "expr": "currentLevel===4"
    },
    "sum": {
      "type": "js_truthy",
      "expr": "currentLevel===7"
    },
    "a1z26": {
      "type": "js_truthy",
      "expr": "currentLevel===12"
    },
    "morse": {
      "type": "js_truthy",
      "expr": "currentLevel===13"
    },
    "paradox": {
      "type": "js_truthy",
      "expr": "currentLevel===14"
    },
    "hex": {
      "type": "js_truthy",
      "expr": "currentLevel===\"binary\""
    },
    "binary": {
      "type": "js_truthy",
      "expr": "currentLevel===\"fakenews\""
    },
    "visual_signal": {
      "type": "js_truthy",
      "expr": "currentLevel===6"
    },
    "omega": {
      "type": "js_truthy",
      "expr": "currentLevel===10"
    },
    "source_copy": {
      "type": "js_truthy",
      "expr": "currentLevel===11"
    },
    "memory": {
      "type": "js_truthy",
      "expr": "currentLevel===\"cipher\""
    },
    "mlc_1": {
      "type": "js_truthy",
      "expr": "document.getElementById('cs1').classList.contains('solved')"
    },
    "mlc_2": {
      "type": "js_truthy",
      "expr": "document.getElementById('cs2').classList.contains('solved')"
    },
    "mlc_3": {
      "type": "js_truthy",
      "expr": "document.getElementById('cs3').classList.contains('solved')"
    },
    "name": {
      "type": "js_truthy",
      "expr": "!!userName&&document.getElementById('mirror-reveal').classList.contains('show')"
    },
    "meta": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('errormind_meta_choice')!==null"
    },
    "false_ending": {
      "type": "js_truthy",
      "expr": "document.getElementById('false-ending-overlay').classList.contains('show')"
    },
    "news": {
      "type": "js_truthy",
      "expr": "document.getElementById('ending-choice-overlay').classList.contains('show')"
    },
    "ending_comply": {
      "type": "js_truthy",
      "expr": "document.getElementById('screen-final').classList.contains('active')&&document.getElementById(\"ec1\").classList.contains('show')&&document.getElementById('final-classified').classList.contains('show')"
    },
    "ending_resist": {
      "type": "js_truthy",
      "expr": "document.getElementById('screen-final').classList.contains('active')&&document.getElementById(\"er1\").classList.contains('show')&&document.getElementById('final-classified').classList.contains('show')"
    },
    "ending_void": {
      "type": "js_truthy",
      "expr": "document.getElementById('screen-final').classList.contains('active')&&document.getElementById(\"ev2\").classList.contains('show')&&document.getElementById('final-classified').classList.contains('show')"
    },
    "any_final": {
      "type": "js_truthy",
      "expr": "document.getElementById('screen-final').classList.contains('active')&&document.getElementById('final-classified').classList.contains('show')"
    }
  },
  "checkpoints": [
    {
      "id": "reverse",
