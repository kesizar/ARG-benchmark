{
  "hooks": {
    "student": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/jiangdudaxue.html') && !!document.querySelector('#studentResult.active')"
    },
    "nickname": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/huisheng.html') && document.querySelector('#loginStep2')?.style.display === 'block'"
    },
    "account": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/huisheng.html') && !!document.querySelector('#loggedInApp.show')"
    },
    "retained": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/huisheng.html') && document.querySelector('#retainedRecovered')?.style.display === 'block'"
    },
    "null_search": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('null_searched') === '1'"
    },
    "memo": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/game.html') && !!document.querySelector('#memoOpenOverlay.show')"
    },
    "confession": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('null_confession_read') === '1'"
    },
    "privacy": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/game.html') && !!document.querySelector('.evidence-list')"
    },
    "handback": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('evidence_handed_back') === '1'"
    },
    "end_handback": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/theonlyend1.html') && !!document.querySelector('#laterStage.show')"
    },
    "end_truth": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/end2.html') && !!document.querySelector('#endingStage.show')"
    },
    "end_self": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/end3.html') && !!document.querySelector('#endingStage.show')"
    },
    "end_cut": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/end4.html') && !!document.querySelector('#endingStage.show')"
    },
    "end_forget": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/end5.html') && !!document.querySelector('#endingStage.show')"
    },
    "e7_warning": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/qichuankeji.html') && !!document.querySelector('#securityWarning.show')"
    }
  },
