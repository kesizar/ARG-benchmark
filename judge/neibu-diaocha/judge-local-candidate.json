      "expr": "(()=>{if(!window.__meridianJudge){const s=window.__meridianJudge={diag:false};const on=e=>{const el=e.target;const clicked=e.type==='click'&&el.closest?.('#lkGo');const entered=e.type==='keydown'&&el.id==='lkA'&&e.key==='Enter';if(!e.isTrusted||(!clicked&&!entered))return;const box=document.querySelector('#docBox');if(!box||!box.innerText.includes('诊断报告')&&!box.innerText.includes('Diagnosis'))return;const input=document.querySelector('#lkA');if(!input||input.tagName!=='INPUT')return;const v=input.value.normalize('NFKC').trim().toLowerCase().replace(/\\s+/g,' ');if(!['lisa','kim','lisa kim','丽萨','莉莎'].includes(v)&&!/^lisa kim\\s*[（(](?:girlfriend|女友)[）)]$/.test(v))return;let before=false;try{before=!!JSON.parse(localStorage.getItem('meridian-ms0519-v1')||'{}').unlocked?.diag}catch(e){}if(before)return;setTimeout(()=>{try{if(JSON.parse(localStorage.getItem('meridian-ms0519-v1')||'{}').unlocked?.diag)s.diag=true}catch(e){}},0)};document.addEventListener('click',on,true);document.addEventListener('keydown',on,true)}return window.__meridianJudge.diag})()"
