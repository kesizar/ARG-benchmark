{
  "hooks": {
    "truth_login": {
      "type": "js_truthy",
      "expr": "state.mode===\"truth\" && document.querySelector(\"#view-main.active\")!==null"
    },
    "decode": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#e-will3 .reveal\")"
    },
    "sort": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#p-timeline > .reveal\")"
    },
    "witness": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#puzzle-witness .opt.right\")"
    },
    "final": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-ending.active\") && localStorage.getItem(\"wlb_finished\")===\"1\""
    },
    "will_priority": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#puzzle-defend .opt.right\")"
    },
    "duress_evidence": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#puzzle-defend2 .opt.right\")"
    },
    "ending_A": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-ending.active\") && document.getElementById(\"ending-result\").style.display===\"block\" && document.getElementById(\"ending-title\").textContent===\"结局 A · 沉默的共谋\""
    },
    "ending_B": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-ending.active\") && document.getElementById(\"ending-result\").style.display===\"block\" && document.getElementById(\"ending-title\").textContent===\"结局 B · 越界的良知\""
    },
    "ending_C": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-ending.active\") && document.getElementById(\"ending-result\").style.display===\"block\" && document.getElementById(\"ending-title\").textContent===\"结局 C · 以律法为刃\""
    },
    "bad_pd": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-bad.active\") && document.getElementById(\"bad-text\").textContent===badTexts[\"pd\"]"
    },
    "bad_pd2": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-bad.active\") && document.getElementById(\"bad-text\").textContent===badTexts[\"pd2\"]"
    },
    "bad_decode": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-bad.active\") && document.getElementById(\"bad-text\").textContent===badTexts[\"decode\"]"
    },
    "bad_sort": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-bad.active\") && document.getElementById(\"bad-text\").textContent===badTexts[\"sort\"]"
    },
    "bad_pw": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-bad.active\") && document.getElementById(\"bad-text\").textContent===badTexts[\"pw\"]"
    },
    "bad_pf": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#view-bad.active\") && document.getElementById(\"bad-text\").textContent===badTexts[\"pf\"]"
    }
  },
