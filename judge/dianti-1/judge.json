{
  "hooks": {
    "connect": {
      "type": "js_truthy",
      "expr": "STATE.terminalUnlocked"
    },
    "plaintext": {
      "type": "js_truthy",
      "expr": "STATE.clues.has(\"最终明文\")"
    },
    "note": {
      "type": "js_truthy",
      "expr": "STATE.noteTaken"
    },
    "board": {
      "type": "js_truthy",
      "expr": "STATE.boardDecoded"
    },
    "password": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"body > #m-password #pwmsg\").textContent.includes(\"密码正确\")"
    },
    "escape": {
      "type": "js_truthy",
      "expr": "STATE.ended && document.querySelector(\"body > #ending\").classList.contains(\"show\") && !document.querySelector(\"body > #ending\").classList.contains(\"easter\") && !document.querySelector(\"body > #ending\").classList.contains(\"fail\") && document.querySelector(\"body > #ending #end-title\").textContent===\"逃离成功\""
    },
    "egg": {
      "type": "js_truthy",
      "expr": "STATE.ended && document.querySelector(\"body > #ending\").classList.contains(\"easter\") && document.querySelector(\"body > #ending\").classList.contains(\"show\")"
    },
    "fall": {
      "type": "js_truthy",
      "expr": "STATE.ended && document.querySelector(\"body > #ending\").classList.contains(\"fail\") && document.querySelector(\"body > #ending\").classList.contains(\"show\")"
    }
  },
  "checkpoints": [
    {
      "id": "connect",
      "hook": "connect",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "password",
      "hook": "password",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "plaintext",
      "hook": "plaintext",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "note",
      "hook": "note",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "board",
      "hook": "board",
      "op": "truthy",
      "role": "diagnostic"
    }
  ],
  "events": {},
  "routes": [
    {
      "id": "escape",
      "tier": "normal",
      "gates": [],
      "ending": {
        "hook": "escape",
        "op": "truthy"
      }
    },
    {
      "id": "egg",
      "tier": "normal",
      "gates": [],
      "ending": {
        "hook": "egg",
        "op": "truthy"
      }
    }
  ],
  "ending": {
    "hook": "escape",
    "op": "truthy"
  },
  "answer_sha256": [],
  "answer_hash_file": null,
  "request_milestones": [],
  "submit_conclusion": {
    "enabled": false,
    "schema": null
  },
  "rubric_path": null,
  "terminal_failures": [
    {
      "id": "fall",
      "hook": "fall",
      "op": "truthy"
    }
  ]
}
