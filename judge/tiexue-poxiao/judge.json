{
  "hooks": {
    "ending": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#screen-end.active\") && !document.querySelector(\"#gameover-overlay\") && document.querySelector(\"#dev-next-jg\")?.style.display !== \"inline-block\""
    },
    "failure_alarm": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#gameover-overlay .go-reason\") && [\"电报机封站\", \"電報機封站\"].some(x => document.querySelector(\"#gameover-overlay .go-reason\").textContent.includes(x))"
    },
    "failure_time": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#gameover-overlay .go-reason\") && [\"十分钟已尽\", \"十分鐘已盡\"].some(x => document.querySelector(\"#gameover-overlay .go-reason\").textContent.includes(x))"
    },
    "archive": {
      "type": "js_truthy",
      "expr": "[\"验押通过\",\"驗押通過\"].some(x => document.querySelector(\"#jp-feedback\")?.textContent.includes(x) === true)"
    },
    "junji": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#obs-junji.done\")"
    },
    "bingbu": {
      "type": "js_truthy",
