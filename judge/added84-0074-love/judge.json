    "drawer": {
      "type": "js_truthy",
      "expr": "typeof G !== 'undefined' && G.drawerOpen === true"
    },
    "quiz": {
      "type": "js_truthy",
      "expr": "typeof quizDone !== 'undefined' && quizDone === true"
    },
