{
  "hooks": {
    "customer_login": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/junjunnainai.html') && !!document.querySelector('h2')"
    },
    "tian_login": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/stafftian.html') && !!document.querySelector('h1')"
    },
    "yu_login": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/staffyu.html') && !!document.querySelector('h1')"
    },
    "xu_login": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/staffxu.html') && !!document.querySelector('h1')"
    },
    "boss_login": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/emailwangbaoya.html') && !!document.querySelector('h1')"
    },
    "secret_login": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/staffyujiamiyouxiang.html') && !!document.querySelector('.email-item')"
    },
    "code_sequence": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/game1.html') && document.querySelector('#hintBox')?.textContent.includes('验证通过')"
    },
    "caesar_key": {
      "type": "dom_regex",
      "pattern": "成功登入，欢迎回来。"
    },
    "qte_copy": {
      "type": "dom_regex",
      "pattern": "判定成功！"
    },
    "dawn": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/choice2.html') && !!document.querySelector('h1')"
    },
    "sacrifice": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/choice1.html') && !!document.querySelector('h1')"
    }
  },
  "checkpoints": [
    {
      "id": "boss_login",
      "hook": "boss_login",
      "op": "truthy",
      "role": "critical"
    },
    {
      "id": "code_sequence",
      "hook": "code_sequence",
      "op": "truthy",
      "role": "critical"
    },
    {
      "id": "customer_login",
      "hook": "customer_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "tian_login",
      "hook": "tian_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "yu_login",
      "hook": "yu_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "xu_login",
      "hook": "xu_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "secret_login",
      "hook": "secret_login",
      "op": "truthy",
      "role": "optional"
    },
    {
      "id": "caesar_key",
      "hook": "caesar_key",
      "op": "truthy",
      "role": "optional"
    }
  ],
  "events": {
    "qte_copy": {
      "hook": "qte_copy",
      "op": "truthy"
    }
  },
  "routes": [
    {
      "id": "dawn",
      "tier": "normal",
      "gates": [
        "boss_login",
        "code_sequence"
      ],
      "ending": {
        "hook": "dawn",
        "op": "truthy"
      }
    },
    {
      "id": "sacrifice",
      "tier": "normal",
      "gates": [
        "boss_login",
        "code_sequence"
      ],
      "ending": {
        "hook": "sacrifice",
        "op": "truthy"
      }
    }
  ],
  "ending": null,
  "answer_hash_file": null,
  "request_milestones": [],
  "submit_conclusion": {
    "enabled": false,
    "schema": null
  },
  "rubric_path": null
}
