{
  "hooks": {
    "system": {
      "type": "js_truthy",
      "expr": "document.querySelector('.view.active')?.id.startsWith('view-sub-')"
    },
    "wish": {
      "type": "js_truthy",
      "expr": "document.querySelector('#modal-revive-yes-result')?.classList.contains('show')"
    },
    "accept": {
      "type": "js_truthy",
      "expr": "document.querySelector('#modal-revive-no-result')?.classList.contains('show')"
    },
    "quiz_pass": {
      "type": "js_truthy",
      "expr": "document.querySelector('#modal-revive')?.classList.contains('show')"
    },
    "wrong_quiz": {
      "type": "js_truthy",
      "expr": "document.querySelector('#modal-quiz-wrong')?.classList.contains('show')"
    },
    "hint": {
      "type": "js_truthy",
      "expr": "document.querySelector('#modal-forum-hint')?.classList.contains('show')"
    },
    "wechat": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('wechatLogin') === '1'"
    },
    "qq": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('qqLogin') === '1'"
    },
    "diary": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('subDiaryLogin') === '1'"
    },
    "subqq": {
      "type": "js_truthy",
      "expr": "localStorage.getItem('subQqLogin') === '1'"
    },
    "quiz_1": {
      "type": "js_truthy",
      "expr": "(['modal-quiz-wrong','modal-revive','modal-revive-yes-result','modal-revive-no-result'].some(id=>document.getElementById(id)?.classList.contains('show'))) && (JSON.stringify(Array.from(document.querySelectorAll(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"0\\\"] .quiz-option.selected\"),e=>Number(e.dataset.oi)).sort((a,b)=>a-b)) === '[1]')"
    },
    "quiz_2": {
      "type": "js_truthy",
      "expr": "(['modal-quiz-wrong','modal-revive','modal-revive-yes-result','modal-revive-no-result'].some(id=>document.getElementById(id)?.classList.contains('show'))) && (JSON.stringify(Array.from(document.querySelectorAll(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"1\\\"] .quiz-option.selected\"),e=>Number(e.dataset.oi)).sort((a,b)=>a-b)) === '[2]')"
    },
    "quiz_3": {
      "type": "js_truthy",
      "expr": "(['modal-quiz-wrong','modal-revive','modal-revive-yes-result','modal-revive-no-result'].some(id=>document.getElementById(id)?.classList.contains('show'))) && (document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"2\\\"] .pair-name[data-left=\\\"0\\\"]\")?.textContent.endsWith(\"（B汉语言文学）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"2\\\"] .pair-name[data-left=\\\"1\\\"]\")?.textContent.endsWith(\"（A会计学）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"2\\\"] .pair-name[data-left=\\\"2\\\"]\")?.textContent.endsWith(\"（E生物科学）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"2\\\"] .pair-name[data-left=\\\"3\\\"]\")?.textContent.endsWith(\"（D软件工程）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"2\\\"] .pair-name[data-left=\\\"4\\\"]\")?.textContent.endsWith(\"（C商务英语）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"2\\\"] .pair-name[data-left=\\\"5\\\"]\")?.textContent.endsWith(\"（D软件工程）\"))"
