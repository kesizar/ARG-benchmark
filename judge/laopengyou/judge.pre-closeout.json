      "expr": "(['modal-quiz-wrong','modal-revive','modal-revive-yes-result','modal-revive-no-result'].some(id=>document.getElementById(id)?.classList.contains('show'))) && (document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"4\\\"] .pair-name[data-left=\\\"0\\\"]\")?.textContent.endsWith(\"（B杂志编辑）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"4\\\"] .pair-name[data-left=\\\"1\\\"]\")?.textContent.endsWith(\"（ECFO）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"4\\\"] .pair-name[data-left=\\\"2\\\"]\")?.textContent.endsWith(\"（A家庭主妇）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"4\\\"] .pair-name[data-left=\\\"3\\\"]\")?.textContent.endsWith(\"（C程序员）\") && document.querySelector(\"#sub-submit-body .quiz-question[data-quiz-index=\\\"4\\\"] .pair-name[data-left=\\\"4\\\"]\")?.textContent.endsWith(\"（D外贸员）\"))"
