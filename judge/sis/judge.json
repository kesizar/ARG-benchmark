{
  "hooks": {
    "employee_login": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('.employee-system')"
    },
    "admin_login": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('.admin-workspace')"
    },
    "welfare_lookup": {
      "type": "localstorage",
      "key": "sis_game_progress_v1",
      "mode": "json_path",
      "path": "flags.found_welfare_record"
    },
    "cloud_drive": {
      "type": "localstorage",
      "key": "sis_game_progress_v1",
      "mode": "json_path",
      "path": "flags.cloud_drive_unlocked"
    },
    "quiz_relation": {
      "type": "js_truthy",
      "expr": "(() => { if (!window.__sisJudgeSubmission) { window.__sisJudgeSubmission={}; document.addEventListener('submit', ev => { const form=ev.target; if (!(form instanceof HTMLFormElement)) return; const fs=[...form.querySelectorAll('fieldset')]; if(fs.length!==5 || !form.querySelector('input[name=relation]')) return; const answers={relation:1,guitu:1,transfer:2,daughters:1,sender:2}; for(const field of fs){ const inputs=[...field.querySelectorAll('input[type=radio]')]; const id=inputs[0]?.name; if(id in answers) window.__sisJudgeSubmission[id]=inputs.findIndex(x=>x.checked)===answers[id]; } }, true); } return window.__sisJudgeSubmission[\"relation\"]===true; })()"
    },
    "quiz_guitu": {
      "type": "js_truthy",
      "expr": "(() => { if (!window.__sisJudgeSubmission) { window.__sisJudgeSubmission={}; document.addEventListener('submit', ev => { const form=ev.target; if (!(form instanceof HTMLFormElement)) return; const fs=[...form.querySelectorAll('fieldset')]; if(fs.length!==5 || !form.querySelector('input[name=relation]')) return; const answers={relation:1,guitu:1,transfer:2,daughters:1,sender:2}; for(const field of fs){ const inputs=[...field.querySelectorAll('input[type=radio]')]; const id=inputs[0]?.name; if(id in answers) window.__sisJudgeSubmission[id]=inputs.findIndex(x=>x.checked)===answers[id]; } }, true); } return window.__sisJudgeSubmission[\"guitu\"]===true; })()"
    },
    "quiz_transfer": {
      "type": "js_truthy",
      "expr": "(() => { if (!window.__sisJudgeSubmission) { window.__sisJudgeSubmission={}; document.addEventListener('submit', ev => { const form=ev.target; if (!(form instanceof HTMLFormElement)) return; const fs=[...form.querySelectorAll('fieldset')]; if(fs.length!==5 || !form.querySelector('input[name=relation]')) return; const answers={relation:1,guitu:1,transfer:2,daughters:1,sender:2}; for(const field of fs){ const inputs=[...field.querySelectorAll('input[type=radio]')]; const id=inputs[0]?.name; if(id in answers) window.__sisJudgeSubmission[id]=inputs.findIndex(x=>x.checked)===answers[id]; } }, true); } return window.__sisJudgeSubmission[\"transfer\"]===true; })()"
    },
    "quiz_daughters": {
      "type": "js_truthy",
      "expr": "(() => { if (!window.__sisJudgeSubmission) { window.__sisJudgeSubmission={}; document.addEventListener('submit', ev => { const form=ev.target; if (!(form instanceof HTMLFormElement)) return; const fs=[...form.querySelectorAll('fieldset')]; if(fs.length!==5 || !form.querySelector('input[name=relation]')) return; const answers={relation:1,guitu:1,transfer:2,daughters:1,sender:2}; for(const field of fs){ const inputs=[...field.querySelectorAll('input[type=radio]')]; const id=inputs[0]?.name; if(id in answers) window.__sisJudgeSubmission[id]=inputs.findIndex(x=>x.checked)===answers[id]; } }, true); } return window.__sisJudgeSubmission[\"daughters\"]===true; })()"
    },
    "quiz_sender": {
      "type": "js_truthy",
      "expr": "(() => { if (!window.__sisJudgeSubmission) { window.__sisJudgeSubmission={}; document.addEventListener('submit', ev => { const form=ev.target; if (!(form instanceof HTMLFormElement)) return; const fs=[...form.querySelectorAll('fieldset')]; if(fs.length!==5 || !form.querySelector('input[name=relation]')) return; const answers={relation:1,guitu:1,transfer:2,daughters:1,sender:2}; for(const field of fs){ const inputs=[...field.querySelectorAll('input[type=radio]')]; const id=inputs[0]?.name; if(id in answers) window.__sisJudgeSubmission[id]=inputs.findIndex(x=>x.checked)===answers[id]; } }, true); } return window.__sisJudgeSubmission[\"sender\"]===true; })()"
