{
  "hooks": {
    "caesar": {
      "type": "js_truthy",
      "expr": "typeof unlockStep!=='undefined'&&unlockStep>=1"
    },
    "morse": {
      "type": "js_truthy",
      "expr": "typeof unlockStep!=='undefined'&&unlockStep>=2"
    },
    "repair": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#repairLogUnlockedArea')&&document.querySelector('#repairLogUnlockedArea').style.display==='block'"
    },
    "p71": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#p71.active')"
    },
    "volume": {
      "type": "js_truthy",
      "expr": "typeof blackScreenRunning!=='undefined'&&blackScreenRunning"
    },
    "terminal": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#terminalModal')&&document.querySelector('#terminalModal').style.display==='flex'"
    },
    "bad": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#endingOverlay.bad-ending.show')"
    },
    "good": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#endingOverlay.perfect-ending.show')"
    }
