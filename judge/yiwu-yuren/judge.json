{
  "hooks": {
    "identity": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/xuesheng.html\") && Array.from(document.querySelectorAll(\".reply-item\")).some(x=>x.textContent.includes(\"你是陈屿。\"))"
    },
    "intent": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/xuesheng.html\") && Array.from(document.querySelectorAll(\".reply-item\")).some(x=>x.textContent.includes(\"你只需要告诉我你这样做是为了什么。\"))"
    },
    "killer": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/xuesheng.html\") && Array.from(document.querySelectorAll(\".reply-item\")).some(x=>x.textContent.includes(\"嫉妒她的周毅\"))"
    },
    "branch1": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/xuesheng.html\") && !!document.querySelector(\"[data-final=true]\") && Array.from(document.querySelectorAll(\".reply-item\")).some(x=>x.textContent.includes(\"我觉得俩人一样该死\"))"
    },
    "end1": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/jj1.html\") && document.querySelector(\".page-indicator\")?.textContent.includes(\"结局一\") && !!window.opener && window.opener.location.pathname.endsWith(\"/001/xuesheng.html\") && Array.from(window.opener.document.querySelectorAll(\"[data-fourth-choice]\")).some(x=>x.dataset.fourthChoice===\"该死\") && !!window.opener.document.querySelector(\"[data-final=true]\")"
    },
    "branch2": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/xuesheng.html\") && !!document.querySelector(\"[data-final=true]\") && Array.from(document.querySelectorAll(\".reply-item\")).some(x=>x.textContent.includes(\"死亡对他这种人来说太轻了。\"))"
    },
    "end2": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/jj2.html\") && document.querySelector(\".page-indicator\")?.textContent.includes(\"结局二\") && !!window.opener && window.opener.location.pathname.endsWith(\"/001/xuesheng.html\") && Array.from(window.opener.document.querySelectorAll(\"[data-fourth-choice]\")).some(x=>x.dataset.fourthChoice===\"不该死\") && !!window.opener.document.querySelector(\"[data-final=true]\")"
    },
    "branch3": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/xuesheng.html\") && !!document.querySelector(\"[data-final=true]\") && Array.from(document.querySelectorAll(\".reply-item\")).some(x=>x.textContent.includes(\"我不想毁了我的信誉 今天我就当没见过你\"))"
    },
    "end3": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/jj3.html\") && document.querySelector(\".page-indicator\")?.textContent.includes(\"结局三\") && !!window.opener && window.opener.location.pathname.endsWith(\"/001/xuesheng.html\") && Array.from(window.opener.document.querySelectorAll(\"[data-fourth-choice]\")).some(x=>x.dataset.fourthChoice===\"who cares？\") && !!window.opener.document.querySelector(\"[data-final=true]\")"
    },
    "wechat": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/weixin.html\")"
    },
    "outlook": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/mailbox.html\")"
    },
    "hospital": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/yiyuanjilu.html\")"
    },
    "teacher": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/001/zhigong.html\")"
    },
    "completed": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith(\"/index.html\") && JSON.parse(localStorage.getItem(\"caseCompleted\")||\"[]\")[0]===true"
    }
  },
