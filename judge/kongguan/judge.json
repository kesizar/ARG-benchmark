      "expr": "(()=>{if((typeof isReviewMode==='boolean'&&isReviewMode)||!location.pathname.endsWith(\"e1ordinary.html\")||new URLSearchParams(location.search).has('review'))return false;const e=JSON.parse(localStorage.getItem('endings_unlocked')||'{}');return e.end01===true&&Array.from(document.querySelectorAll('.ending-title,.ending-label')).some(x=>x.textContent.replace(/\\s/g,'').includes(\"结局·平凡的一生\")&&x.getBoundingClientRect().height>0&&x.checkVisibility({checkOpacity:true,checkVisibilityCSS:true}));})()"
