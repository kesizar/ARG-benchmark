      "type": "js_truthy",
      "expr": "(()=>{const a=typeof answers==='object'?answers:JSON.parse(localStorage.getItem('exam_answers')||'{}');return Array.isArray(a.q27)&&a.q27.length===4&&['健康','财富','自由','尊严'].every(v=>a.q27.includes(v));})()"
