    "door": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#msg1.success\")?.textContent.includes(\"锁舌弹开\") === true"
    },
    "drawer": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#msg2.success\")?.textContent.includes(\"抽屉弹开\") === true"
    },
    "corrected": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#msg4.success\")?.textContent.includes(\"修正过的正确密码\") === true"
    },
    "true": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#endingScreen.show\") && document.querySelector(\"#endingLabel\")?.textContent === \"TRUE ENDING\""
