{
  "hooks": {
    "name": {
      "type": "js_truthy",
      "expr": "unlocked[0] === true && !!document.querySelector('#l0 .lock-body.open')"
    },
    "choice": {
      "type": "js_truthy",
      "expr": "unlocked[1] === true && !!document.querySelector('#l1 .lock-body.open')"
    },
    "glyphs": {
      "type": "js_truthy",
      "expr": "unlocked[2] === true && !!document.querySelector('#l2 .lock-body.open')"
    },
    "timeline": {
      "type": "js_truthy",
      "expr": "unlocked[3] === true && !!document.querySelector('#l3 .lock-body.open')"
    },
    "final": {
      "type": "js_truthy",
      "expr": "unlocked[4] === true && !!document.querySelector('#l4 .lock-body.open')"
    },
    "ending": {
      "type": "js_truthy",
      "expr": "unlocked.every(Boolean) && document.querySelector('#c5').classList.contains('visible') && document.querySelector('#story').classList.contains('active')"
    }
  },
