{
  "hooks": {
    "found": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#fr-result') && document.querySelector('#fr-result').innerText.includes('结局 · 寻回')"
    },
    "peril": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#fr-result') && document.querySelector('#fr-result').innerText.includes('结局 · 险途')"
    },
    "tooLate": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#fr-result') && document.querySelector('#fr-result').innerText.includes('结局 · 迟了一步')"
    },
    "wrong": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#fr-result') && document.querySelector('#fr-result').innerText.includes('结局 · 误判')"
    },
    "missed": {
      "type": "js_truthy",
      "expr": "!!document.querySelector('#fr-result') && document.querySelector('#fr-result').innerText.includes('结局 · 失之交臂')"
    },
    "capsule": {
      "type": "js_truthy",
      "expr": "typeof S !== \"undefined\" && S.unlocked === true"
    },
    "binary_diagnostic": {
      "type": "js_truthy",
      "expr": "typeof S !== \"undefined\" && Array.isArray(S.clues) && S.clues.includes(\"door7\")"
    }
  },
  "checkpoints": [
