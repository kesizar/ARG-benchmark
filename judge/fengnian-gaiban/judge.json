{
  "hooks": {
    "archive": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/recycle.html') && (document.querySelector('#doneWrap')?.classList.contains('show'))"
    },
    "geometry": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/zhiliao.html') && (document.querySelector('#resultBox')?.style.display==='block')"
    },
    "identity": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/em.html') && (true)"
    },
    "base64_diary": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/kill.html') && (true)"
    },
    "birth": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/real.html') && (true)"
    },
    "black_decode": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/black.html') && (true)"
    },
    "unlocked": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/index.html') && document.querySelector('#lockScreen')?.style.display==='none'"
    },
    "camera_denied": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/wugan1.html') && (document.body.innerText.includes('摄像头没有开启'))"
    },
    "self_end1": {
      "type": "js_truthy",
      "expr": "location.pathname.endsWith('/self_end1.html') && (document.querySelector('.ec-card')?.classList.contains('show'))"
    },
    "self_end2": {
