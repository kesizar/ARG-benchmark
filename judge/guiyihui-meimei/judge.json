      "expr": "(()=>{if(!document.querySelector('#panel-level-indicator'))return false;if(!window.__benchGuiyi){const s=window.__benchGuiyi={solved:{},hints:{},skips:{},jumps:0,photo:false};document.addEventListener('click',e=>{if(!e.isTrusted)return;const b=e.target.closest('button');if(!b)return;const n=parseInt(document.querySelector('#panel-level-indicator').textContent);const a=b.getAttribute('onclick')||'';if(a.includes('toggleHint'))s.hints[n]=true;if(a.includes('skipLevelEpiphany'))s.skips[n]=true;if(b.closest('#levels-quick-nav'))s.jumps++;if(b.id==='btn-validate'){const before=n;setTimeout(()=>{let now=parseInt(document.querySelector('#panel-level-indicator').textContent);if((now===before+1||(before===50&&!document.querySelector('#ending-overlay').classList.contains('hidden')&&!document.querySelector('#ending-title').textContent.includes('结局 A')))&&!s.hints[before]&&!s.skips[before]&&(![21,22].includes(before)||s.photo))s.solved[before]=true;},0)}},true)}if(!document.querySelector(\"#win-photos\").classList.contains(\"hidden\") && document.querySelector(\"#hidden-rune-text\").classList.contains(\"opacity-100\"))window.__benchGuiyi.photo=true;return true})()"
