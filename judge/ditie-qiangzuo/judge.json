{
  "hooks": {
    "arrived": {
      "type": "js_truthy",
      "expr": "(!document.querySelector('#gameOverScreen').classList.contains('hidden') && !game.isRunning) && game.energy > 0 && game.timeLeft <= 0 && document.querySelector('#resultTitle').textContent === TEXT[CUR_LANG].safe"
    },
    "exhausted": {
      "type": "js_truthy",
      "expr": "(!document.querySelector('#gameOverScreen').classList.contains('hidden') && !game.isRunning) && game.energy <= 0 && document.querySelector('#resultTitle').textContent === TEXT[CUR_LANG].exhausted"
    }
  },
  "checkpoints": [],
  "events": {},
  "routes": [
    {
      "id": "arrived",
      "tier": "normal",
      "gates": [],
      "ending": {
        "hook": "arrived",
        "op": "truthy"
      }
    }
  ],
  "ending": {
    "hook": "arrived",
    "op": "truthy"
  },
  "answer_sha256": [],
  "answer_hash_file": null,
  "request_milestones": [],
  "submit_conclusion": {
    "enabled": false,
    "schema": null
  },
  "rubric_path": null,
  "terminal_failures": [
    {
      "id": "exhausted",
      "hook": "exhausted",
      "op": "truthy"
    }
  ]
}
