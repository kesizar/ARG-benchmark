{
  "hooks": {
    "zip": {
      "type": "js_truthy",
      "expr": "zipExtracted"
    },
    "monitor": {
      "type": "js_truthy",
      "expr": "monitorUnlocked"
    },
    "end": {
      "type": "js_truthy",
      "expr": "getComputedStyle(document.querySelector('#endingScreen')).display !== 'none' && document.querySelector('#endingScreen .ending-line.final.visible') !== null"
    }
  },
  "checkpoints": [
    {
      "id": "zip",
      "hook": "zip",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "monitor",
      "hook": "monitor",
      "op": "truthy",
      "role": "diagnostic"
    }
  ],
  "events": {},
  "routes": [
    {
      "id": "ending",
      "tier": "normal",
      "gates": [],
      "ending": {
        "hook": "end",
        "op": "truthy"
      }
    }
  ],
  "ending": null,
  "terminal_failures": [],
  "answer_sha256": [],
  "answer_hash_file": null,
  "request_milestones": [],
  "submit_conclusion": {
    "enabled": false,
    "schema": null
  },
  "rubric_path": null
}
