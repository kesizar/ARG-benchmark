{
  "hooks": {
    "complete": {
      "type": "js_truthy",
      "expr": "document.querySelector('#log')?.textContent === '结论：非人类' && document.querySelector('#wrap .sub')?.textContent.includes('验证完成')"
    },
    "mask": {
      "type": "js_truthy",
      "expr": "document.querySelector('#log')?.textContent === '伪装协议：已启动' && document.querySelector('#wrap .sub')?.textContent.includes('欢迎回来')"
    },
    "real_A": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#wrap .sub\")?.textContent === \"错了。但没关系。\""
    },
    "real_B": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#wrap .sub\")?.textContent === \"对。但你确定吗？\""
    },
    "not_human": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#wrap .sub\")?.textContent === \"我也是这么想的。\""
    },
    "behind": {
      "type": "js_truthy",
      "expr": "document.querySelector(\"#wrap .sub\")?.textContent === \"你没有回头。很好。\""
    }
  },
  "checkpoints": [],
  "events": {
    "mask": {
      "hook": "mask",
      "op": "truthy"
    },
    "real_A": {
      "hook": "real_A",
      "op": "truthy"
    },
    "real_B": {
      "hook": "real_B",
      "op": "truthy"
    },
    "not_human": {
      "hook": "not_human",
      "op": "truthy"
    },
    "behind": {
      "hook": "behind",
      "op": "truthy"
    }
  },
  "routes": [
    {
      "id": "complete",
      "gates": [],
      "ending": {
        "hook": "complete",
        "op": "truthy"
      }
    }
  ]
}