{
  "hooks": {
    "ending": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#page-hidden.active\")"
    },
    "page0": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#page-news.active\") && document.querySelector(\"#hidden-news-0\")?.style.display === \"block\""
    },
    "keyword": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#page-contact.active #formReply.show\") && document.querySelector(\"#formReply\")?.textContent.includes(\"/memory/linxiaoyu\") === true"
    },
    "template": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#page-contact.active #formReply.show\") && document.querySelector(\"#formReply\")?.textContent.includes(\"这条回复是模板\") === true"
    },
    "log": {
      "type": "js_truthy",
      "expr": "!!document.querySelector(\"#page-contact.active #formReply.show\") && document.querySelector(\"#formReply\")?.textContent.includes(\"20141110-001\") === true"
    }
  },
  "checkpoints": [
    {
      "id": "page0",
      "hook": "page0",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "keyword",
      "hook": "keyword",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "template",
      "hook": "template",
      "op": "truthy",
      "role": "diagnostic"
    },
    {
      "id": "log",
      "hook": "log",
      "op": "truthy",
      "role": "diagnostic"
    }
  ],
  "events": {},
  "routes": [
    {
      "id": "hidden",
      "gates": [],
      "ending": {
        "hook": "ending",
        "op": "truthy"
      }
    }
  ],
  "terminal_failures": [],
  "answer_sha256": [],
  "request_milestones": [],
  "submit_conclusion": {
    "enabled": false,
    "schema": null
  }
}
